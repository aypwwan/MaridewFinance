<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the desktop app's pure logic: sync fingerprinting, row
    merging, tombstones, KDF vectors, blob encode/decode, version compares.
    References the app project directly (net8.0-windows + WPF because the
    service classes touch App/Application) and reaches its `internal`
    helpers via InternalsVisibleTo. Database/WebView-dependent paths stay
    covered by the manual smoke checklist in RELEASE.md.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaridewFinance.App\MaridewFinance.App.csproj" />
  </ItemGroup>

</Project>
