<Window x:Class="MaridewFinance.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                Title="Maridew Finance - Wealth Management"
        Icon="app.ico"
        Height="900" Width="1440"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#090D16">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading indicator shown until the local web app finishes loading -->
        <TextBlock x:Name="LoadingText"
                   Text="Loading Maridew Finance..."
                   Foreground="#94a3b8"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Panel.ZIndex="1"/>

        <wv2:WebView2 x:Name="Browser" />
    </Grid>
</Window>
