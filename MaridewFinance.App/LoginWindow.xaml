<Window x:Class="MaridewFinance.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maridew Finance - Sign In"
        Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#090D16">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Branding -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,16">
            <Border Width="56" Height="56" CornerRadius="14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#34D399" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="M" FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Maridew Finance" FontSize="18" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,2"/>
            <TextBlock Text="Sign in to your account, or create one below."
                       FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Mode switch -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Button x:Name="TabSignIn" Content="Sign In" Click="OnSwitchMode"
                    Tag="signin" Padding="14,5" Margin="0,0,8,0"/>
            <Button x:Name="TabCreate" Content="Create Account" Click="OnSwitchMode"
                    Tag="create" Padding="14,5"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <TextBlock Text="Username" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox" Height="32" Padding="6,4" Margin="0,0,0,10"/>

            <TextBlock x:Name="ConfirmLabel" Text="Confirm Password" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4" Visibility="Collapsed"/>
            <PasswordBox x:Name="ConfirmBox" Height="32" Padding="6,4" Margin="0,0,0,10" Visibility="Collapsed"/>

            <TextBlock Text="Password" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="32" Padding="6,4"/>

            <TextBlock x:Name="ErrorText" Foreground="#FB7185" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Action -->
        <Button x:Name="PrimaryButton" Grid.Row="3" Content="Sign In" Click="OnPrimary"
                Height="38" FontSize="14" FontWeight="SemiBold" IsDefault="True"
                Background="#4F46E5" Foreground="White" BorderThickness="0"
                Cursor="Hand" Margin="0,16,0,0"/>
    </Grid>
</Window>
