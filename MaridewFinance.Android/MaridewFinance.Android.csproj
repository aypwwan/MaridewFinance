<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Maridew Finance for Android

    A lightweight native wrapper that ships the SAME dashboard the desktop app
    uses (MaridewFinance.App/wwwroot) inside the system WebView, served from the
    APK assets via androidx.webkit WebViewAssetLoader so the page runs on a real
    https:// origin (required for IndexedDB and WebCrypto - the web edition's
    cloud-sync crypto needs both).

    The web bridge (web-bridge.js) activates automatically: it only stands down
    inside WebView2 where the real C# bridges exist, and Android WebView exposes
    no hostObjects. All storage stays on-device in IndexedDB; cloud sync works
    exactly as in the browser edition.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationId>com.maridew.finance</ApplicationId>
    <ApplicationTitle>Maridew Finance</ApplicationTitle>
    <ApplicationVersion>10005</ApplicationVersion>
    <ApplicationVersionName>1.0.5</ApplicationVersionName>

    <!-- Android 8.0+. The system WebView is a component that updates via Play,
         but very old OS builds ship WebViews too old for reliable WebCrypto/
         IndexedDB behaviour in a finance app - 26 is the floor we test against. -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- Keep code running under the app package for privacy, use a real app
         name for the WebView user agent and asset-loader domain. -->
    <ApplicationLabel>Maridew Finance</ApplicationLabel>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Single universal ABI keeps the artifact one installable file. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

    <AndroidResgenFile>Resources\Resource.designer.cs</AndroidResgenFile>
    <AndroidResgenClass>Resource</AndroidResgenClass>

    <!-- Stable release signing. The committed keystore's passwords are NOT a
         secret worth stealing (the key's only job is install-upgrade
         continuity - see RELEASE.md); still, both the keystore and the
         passwords can be overridden for local or CI builds via the
         MARIDEW_ANDROID_KEYSTORE / MARIDEW_ANDROID_KEYPASS /
         MARIDEW_ANDROID_STOREPASS environment variables, e.g. to build with a
         private keystore without editing this file. -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore Condition="'$(MARIDEW_ANDROID_KEYSTORE)' != ''">$(MARIDEW_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyStore Condition="'$(MARIDEW_ANDROID_KEYSTORE)' == ''">maridew.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>maridew</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass Condition="'$(MARIDEW_ANDROID_KEYPASS)' != ''">$(MARIDEW_ANDROID_KEYPASS)</AndroidSigningKeyPass>
    <AndroidSigningKeyPass Condition="'$(MARIDEW_ANDROID_KEYPASS)' == ''">maridew</AndroidSigningKeyPass>
    <AndroidSigningStorePass Condition="'$(MARIDEW_ANDROID_STOREPASS)' != ''">$(MARIDEW_ANDROID_STOREPASS)</AndroidSigningStorePass>
    <AndroidSigningStorePass Condition="'$(MARIDEW_ANDROID_STOREPASS)' == ''">maridew</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.17.0" />
  </ItemGroup>

  <!-- Ship the shared dashboard inside the APK assets. -->
  <ItemGroup>
    <AndroidAsset Include="..\MaridewFinance.App\wwwroot\**\*">
      <Link>Assets\wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>

</Project>
